<Window x:Class="MotionControl.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MotionControl.Wpf.ViewModels"
        Title="激光设备上位机 · WPF" Width="1160" Height="800" MinWidth="1020" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#10141b" Foreground="#d7dee9"
        FontFamily="Microsoft YaHei UI" FontSize="13" Loaded="Window_Loaded" Closing="Window_Closing">
  <Window.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#2dd4bf"/>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#1a2230"/><Setter Property="BorderBrush" Value="#303c50"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#94a3b8"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="#d7dee9"/><Setter Property="Background" Value="#273348"/>
      <Setter Property="BorderBrush" Value="#3b4a61"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="4"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Background" Value="#35445d"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="border" Property="Opacity" Value="0.38"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="#17665c"/><Setter Property="BorderBrush" Value="#218c7d"/>
    </Style>
    <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="#612832"/><Setter Property="BorderBrush" Value="#a13b48"/><Setter Property="Foreground" Value="#ffc2c8"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0f1622"/><Setter Property="Foreground" Value="#d7dee9"/>
      <Setter Property="BorderBrush" Value="#3b4a61"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="7,5"/><Setter Property="Margin" Value="4"/><Setter Property="CaretBrush" Value="#2dd4bf"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#1b2637"/><Setter Property="Foreground" Value="#e5edf7"/>
      <Setter Property="BorderBrush" Value="#3b4a61"/><Setter Property="Padding" Value="6,4"/><Setter Property="Margin" Value="4"/>
    </Style>
    <Style x:Key="StatusBadge" TargetType="Border">
      <Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="10,3"/><Setter Property="Background" Value="#4a2c25"/>
      <Style.Triggers><DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Background" Value="#155e55"/></DataTrigger></Style.Triggers>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
  </Window.Resources>

  <Grid Margin="14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

    <!-- 连接 -->
    <Border Style="{StaticResource Card}" Grid.Row="0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel>
          <StackPanel DockPanel.Dock="Left">
            <TextBlock Text="激光设备上位机" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="WPF · WebSocket · 模拟设备控制" Foreground="#7f8da3" Margin="0,3,0,0"/>
          </StackPanel>
          <Border Style="{StaticResource StatusBadge}" DockPanel.Dock="Right" VerticalAlignment="Center">
            <TextBlock Text="{Binding ConnectionStatus}" Foreground="#e5f8f3"/>
          </Border>
        </DockPanel>
        <Grid Grid.Row="1" Margin="0,12,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="服务地址" VerticalAlignment="Center" Foreground="#94a3b8" Margin="4"/>
          <TextBox Grid.Column="1" Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="server-url"/>
          <Button Grid.Column="2" Style="{StaticResource PrimaryBtn}" Content="{Binding ConnectButtonText}"
                  Command="{Binding ConnectCommand}" AutomationProperties.AutomationId="btn-connect"/>
          <Button Grid.Column="3" Style="{StaticResource Btn}" Content="打开 3D 页面" Command="{Binding OpenBrowserCommand}"/>
          <Button Grid.Column="4" Style="{StaticResource Btn}" Content="脚本" Click="OpenScriptsWindow" AutomationProperties.AutomationId="btn-open-scripts"/>
        </Grid>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.02*"/><ColumnDefinition Width="0.98*"/></Grid.ColumnDefinitions>

      <!-- 左侧：轴状态与手动控制 -->
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,6,0">
        <StackPanel>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="三轴状态 · mm / mm·s⁻¹"/>
              <Grid Margin="0,0,0,5" TextElement.Foreground="#718198">
                <Grid.ColumnDefinitions><ColumnDefinition Width="0.5*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                <TextBlock Text="轴"/><TextBlock Grid.Column="1" Text="位置"/><TextBlock Grid.Column="2" Text="速度"/><TextBlock Grid.Column="3" Text="状态"/>
              </Grid>
              <ItemsControl ItemsSource="{Binding Axes}">
                <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:AxisStatusViewModel}">
                  <Border Background="#101722" CornerRadius="5" Padding="9,6" Margin="0,3">
                    <Grid TextElement.FontFamily="Consolas">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="0.5*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Name}" Foreground="#2dd4bf" FontWeight="Bold"/>
                      <TextBlock Grid.Column="1" Text="{Binding Position}" FontSize="15"/>
                      <TextBlock Grid.Column="2" Text="{Binding Velocity}" Foreground="#9aa8ba"/>
                      <TextBlock Grid.Column="3" Text="{Binding State}" Foreground="#d7dee9"/>
                    </Grid>
                  </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <DockPanel Margin="0,8,0,0">
                <TextBlock Text="控制模式" Foreground="#8291a7"/>
                <TextBlock Text="{Binding Mode}" DockPanel.Dock="Right" Foreground="#2dd4bf" FontFamily="Consolas"/>
              </DockPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="手动运动与激光"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="95"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="PTP" VerticalAlignment="Center" Margin="4" Foreground="#94a3b8"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding AxisNames}" SelectedItem="{Binding PtpAxis}" AutomationProperties.AutomationId="ptp-axis"/>
                <TextBox Grid.Column="2" Text="{Binding PtpPosition}" AutomationProperties.AutomationId="ptp-position"/>
                <Button Grid.Column="3" Style="{StaticResource Btn}" Content="定位" Command="{Binding PtpCommand}"/>
              </Grid>

              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="X" Foreground="#ff7373" VerticalAlignment="Center" Margin="5"/>
                <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource Btn}" Content="X −" Tag="x,-1" PreviewMouseLeftButtonDown="JogStart" PreviewMouseLeftButtonUp="JogStop" MouseLeave="JogStop"/>
                <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource Btn}" Content="X ＋" Tag="x,1" PreviewMouseLeftButtonDown="JogStart" PreviewMouseLeftButtonUp="JogStop" MouseLeave="JogStop"/>
                <TextBlock Grid.Row="1" Text="Y" Foreground="#65d98a" VerticalAlignment="Center" Margin="5"/>
                <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource Btn}" Content="Y −" Tag="y,-1" PreviewMouseLeftButtonDown="JogStart" PreviewMouseLeftButtonUp="JogStop" MouseLeave="JogStop"/>
                <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource Btn}" Content="Y ＋" Tag="y,1" PreviewMouseLeftButtonDown="JogStart" PreviewMouseLeftButtonUp="JogStop" MouseLeave="JogStop"/>
                <TextBlock Grid.Row="2" Text="Z" Foreground="#74c0fc" VerticalAlignment="Center" Margin="5"/>
                <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource Btn}" Content="Z −" Tag="z,-1" PreviewMouseLeftButtonDown="JogStart" PreviewMouseLeftButtonUp="JogStop" MouseLeave="JogStop"/>
                <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource Btn}" Content="Z ＋" Tag="z,1" PreviewMouseLeftButtonDown="JogStart" PreviewMouseLeftButtonUp="JogStop" MouseLeave="JogStop"/>
                <Button Grid.Row="0" Grid.Column="3" Style="{StaticResource PrimaryBtn}" Content="回零" Command="{Binding HomeCommand}" AutomationProperties.AutomationId="btn-home"/>
                <Button Grid.Row="1" Grid.Column="3" Style="{StaticResource DangerBtn}" Content="急停" Command="{Binding EstopCommand}" AutomationProperties.AutomationId="btn-estop"/>
                <Button Grid.Row="2" Grid.Column="3" Style="{StaticResource Btn}" Content="{Binding LaserButtonText}" Command="{Binding LaserCommand}"/>
              </Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="独立加工作业"/>
              <UniformGrid Columns="3">
                <Button Style="{StaticResource Btn}" Content="五角星" Command="{Binding JobCommand}" CommandParameter="star"/>
                <Button Style="{StaticResource Btn}" Content="整圆" Command="{Binding JobCommand}" CommandParameter="circle"/>
                <Button Style="{StaticResource Btn}" Content="综合图案" Command="{Binding JobCommand}" CommandParameter="combo"/>
              </UniformGrid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- 右侧：自动生产与日志 -->
      <Grid Grid.Column="1" Margin="6,0,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="自动上下料生产"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{Binding PhaseText}" FontSize="22" FontWeight="SemiBold" Foreground="#2dd4bf" AutomationProperties.AutomationId="production-phase"/>
                <TextBlock Text="{Binding WorkpieceInfo}" Foreground="#a5b3c5" Margin="0,4,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock Text="已完成" Foreground="#8291a7" HorizontalAlignment="Right"/>
                <TextBlock Text="{Binding CompletedText}" FontSize="19" HorizontalAlignment="Right" AutomationProperties.AutomationId="production-completed"/>
              </StackPanel>
            </Grid>
            <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="7" Margin="0,13,0,4" Foreground="#2dd4bf" Background="#0e1520" BorderThickness="0"/>
            <DockPanel><TextBlock Text="{Binding ProductionDetail}" Foreground="#8291a7"/><TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" Foreground="#a5b3c5"/></DockPanel>

            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
              <TextBlock Text="加工程序" VerticalAlignment="Center" Margin="4" Foreground="#94a3b8"/>
              <ComboBox Grid.Column="1" ItemsSource="{Binding Recipes}" DisplayMemberPath="Name" SelectedValuePath="Value"
                        SelectedValue="{Binding SelectedRecipe}" AutomationProperties.AutomationId="production-recipe"/>
              <TextBlock Grid.Column="2" Text="数量" VerticalAlignment="Center" Margin="4" Foreground="#94a3b8"/>
              <TextBox Grid.Column="3" Text="{Binding ProductionCount}" AutomationProperties.AutomationId="production-count"/>
            </Grid>
            <UniformGrid Columns="2" Margin="0,6,0,0">
              <Button Style="{StaticResource PrimaryBtn}" Content="单件 / 指定数量" Command="{Binding StartSingleCommand}" AutomationProperties.AutomationId="btn-production-single"/>
              <Button Style="{StaticResource Btn}" Content="连续生产" Command="{Binding StartContinuousCommand}"/>
            </UniformGrid>
            <UniformGrid Columns="2">
              <Button Style="{StaticResource Btn}" Content="本件后停止" Command="{Binding StopProductionCommand}"/>
              <Button Style="{StaticResource DangerBtn}" Content="复位产线" Command="{Binding ResetProductionCommand}" AutomationProperties.AutomationId="btn-production-reset"/>
            </UniformGrid>
            <TextBlock Text="流程：出料 → 推料 → 夹紧 → 加工 → 松夹 → 下料" Foreground="#718198" TextWrapping="Wrap" Margin="4,7,4,0"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Grid.Row="1" Margin="0">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,6">
              <TextBlock Style="{StaticResource CardTitle}" Text="运行日志" Margin="0"/>
              <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="清空" Padding="9,2" Command="{Binding ClearLogCommand}"/>
            </DockPanel>
            <ListBox Grid.Row="1" ItemsSource="{Binding LogEntries}" AutomationProperties.AutomationId="log-list">
              <ListBox.ItemTemplate><DataTemplate DataType="{x:Type vm:LogEntry}">
                <Grid Margin="0,2">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Time}" Foreground="#5f6f86" FontFamily="Consolas" FontSize="11"/>
                  <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap">
                    <TextBlock.Style><Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="#a5b3c5"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Level}" Value="ok"><Setter Property="Foreground" Value="#2dd4bf"/></DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="warn"><Setter Property="Foreground" Value="#e8b64c"/></DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="error"><Setter Property="Foreground" Value="#ff8d99"/></DataTrigger>
                      </Style.Triggers>
                    </Style></TextBlock.Style>
                  </TextBlock>
                </Grid>
              </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
