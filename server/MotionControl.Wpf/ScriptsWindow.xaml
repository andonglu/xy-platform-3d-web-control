<Window x:Class="MotionControl.Wpf.ScriptsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MotionControl.Wpf.ViewModels"
        xmlns:scripting="clr-namespace:MotionControl.Scripting;assembly=MotionControl.Scripting"
        Title="设备脚本 · C# CSX" Width="1100" Height="760" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#10141b" Foreground="#d7dee9" FontFamily="Microsoft YaHei UI" FontSize="13">
  <Window.Resources>
    <Style x:Key="ScriptBtn" TargetType="Button">
      <Setter Property="Foreground" Value="#d7dee9"/><Setter Property="Background" Value="#273348"/>
      <Setter Property="BorderBrush" Value="#3b4a61"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="13,7"/><Setter Property="Margin" Value="4"/><Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="RunBtn" TargetType="Button" BasedOn="{StaticResource ScriptBtn}"><Setter Property="Background" Value="#17665c"/></Style>
    <Style x:Key="StopBtn" TargetType="Button" BasedOn="{StaticResource ScriptBtn}"><Setter Property="Background" Value="#612832"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#0f1622"/><Setter Property="Foreground" Value="#d7dee9"/><Setter Property="BorderBrush" Value="#3b4a61"/><Setter Property="Padding" Value="8"/></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="#141c29"/><Setter Property="Foreground" Value="#d7dee9"/><Setter Property="BorderBrush" Value="#303c50"/></Style>
  </Window.Resources>
  <Grid Margin="14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="180"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#1a2230" BorderBrush="#303c50" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
      <StackPanel>
        <WrapPanel>
          <Button Style="{StaticResource ScriptBtn}" Content="重新扫描" Command="{Binding ReloadCommand}"/>
          <Button Style="{StaticResource ScriptBtn}" Content="保存并检查" Command="{Binding SaveCommand}" AutomationProperties.AutomationId="script-save"/>
          <Button Style="{StaticResource RunBtn}" Content="运行脚本" Command="{Binding RunCommand}" AutomationProperties.AutomationId="script-run"/>
          <Button Style="{StaticResource StopBtn}" Content="停止并急停" Command="{Binding StopCommand}" AutomationProperties.AutomationId="script-stop"/>
          <TextBlock Text="脚本只通过受限 Machine API 控制设备，运行期间独占设备操作权" Foreground="#718198" VerticalAlignment="Center" Margin="10,4"/>
        </WrapPanel>
        <TextBlock Text="{Binding StatusText}" Foreground="#2dd4bf" Margin="4,7,4,0" AutomationProperties.AutomationId="script-status"/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="285"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border BorderBrush="#303c50" BorderThickness="1" CornerRadius="7" Margin="0,0,5,10">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="Scripts / Stage + Machine" Foreground="#8c9cb2" Margin="10,8"/>
          <ListBox Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedScript}" BorderThickness="0" AutomationProperties.AutomationId="script-list">
            <ListBox.ItemTemplate><DataTemplate DataType="{x:Type scripting:ScriptDescriptor}">
              <StackPanel Margin="4"><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding DisplayState}" Foreground="#8291a7" FontSize="11" TextWrapping="Wrap"/></StackPanel>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
      <Border Grid.Column="1" BorderBrush="#303c50" BorderThickness="1" CornerRadius="7" Margin="5,0,0,10">
        <TextBox Text="{Binding EditorText, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="14"
                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" BorderThickness="0" Padding="12"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.AutomationId="script-editor"/>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="#1a2230" BorderBrush="#303c50" BorderThickness="1" CornerRadius="8" Padding="8">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,5"><TextBlock Text="脚本日志" Foreground="#8c9cb2"/><Button DockPanel.Dock="Right" Style="{StaticResource ScriptBtn}" Padding="8,1" Content="清空" Command="{Binding ClearLogCommand}"/></DockPanel>
        <ListBox Grid.Row="1" ItemsSource="{Binding Logs}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate><DataTemplate DataType="{x:Type vm:LogEntry}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Time}" Foreground="#5f6f86" FontFamily="Consolas" FontSize="11"/>
              <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" Foreground="#a5b3c5"/>
            </Grid>
          </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
  </Grid>
</Window>
